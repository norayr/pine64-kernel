#!/usr/bin/make -f
export DH_VERBOSE=1
export ARCH=arm64
DEV    = pinephone
DTB    = \
  allwinner/sun50i-a64-pinephone-1.0.dtb \
  allwinner/sun50i-a64-pinephone-1.1.dtb \
  allwinner/sun50i-a64-pinephone-1.2.dtb \
  allwinner/sun50i-a64-pinetab.dtb \
  allwinner/sun50i-a64-pinetab-early-adopter.dtb

# Parallel build from DEB_BUILD_OPTIONS=parallel=N
ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
  NUMJOBS := $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
  export MAKEFLAGS += -j$(NUMJOBS)
endif

# Cross
ifneq ($(DEB_BUILD_GNU_TYPE),$(DEB_TARGET_MULTIARCH))
  export CROSS_COMPILE=$(DEB_TARGET_MULTIARCH)-
endif

%:
	dh $@

override_dh_auto_configure:
	# Use your known-good config as the base
	cp -v $(CURDIR)/debian/config_inky .config
	$(MAKE) olddefconfig
	# Force critical boot/display options
	./scripts/config --file .config \
	  --enable CONFIG_DEVTMPFS \
	  --enable CONFIG_DEVTMPFS_MOUNT \
	  --enable CONFIG_MMC \
	  --enable CONFIG_MMC_BLOCK \
	  --enable CONFIG_MMC_SUNXI \
	  --enable CONFIG_EXT4_FS \
	  --enable CONFIG_DRM \
	  --enable CONFIG_DRM_KMS_HELPER \
	  --enable CONFIG_DRM_SIMPLEDRM \
	  --enable CONFIG_FRAMEBUFFER_CONSOLE \
	  --enable CONFIG_DRM_SUN4I \
	  --enable CONFIG_DRM_SUN6I_DSI \
	  --enable CONFIG_DRM_PANEL_SITRONIX_ST7703 \
	  --enable CONFIG_DRM_PANEL_SIMPLE \
	  --enable CONFIG_DRM_SIMPLE_BRIDGE \
	  --enable CONFIG_BTRFS_FS \
	  --enable CONFIG_USB_CONFIGFS_F_FS \
	  --enable CONFIG_TYPEC \
	  --enable CONFIG_TYPEC_ANX7688 \
	  --enable CONFIG_INPUT_AXP20X_PEK \
	  --enable CONFIG_CHARGER_AXP20X_BATTERY \
	  --enable CONFIG_BATTERY_AXP20X \
	  --enable CONFIG_BACKLIGHT_PWM \
	  --enable CONFIG_DRM_PANEL_HIMAX_HX8369
	$(MAKE) olddefconfig

override_dh_auto_build:
	$(MAKE) Image.gz modules dtbs

override_dh_auto_install:
	# Get kernel release using make eval (this works properly in Makefile context)
	$(eval KREL := $(shell cat include/config/kernel.release 2>/dev/null || echo "unknown"))
	@echo "Kernel release: $(KREL)"
	@if [ "$(KREL)" = "unknown" ]; then \
		echo "ERROR: Failed to determine kernel release" >&2; \
		exit 1; \
	fi
	
	# 1) Headers into /usr/src/linux-headers-<krel>
	$(MAKE) headers_install \
	  INSTALL_HDR_PATH=$(CURDIR)/debian/linux-headers-pine64/usr/src/linux-headers-$(KREL)
	
	# 2) Modules into linux-image-pine64
	$(MAKE) modules_install INSTALL_MOD_PATH=$(CURDIR)/debian/linux-image-pine64
	
	# 3) Kernel image (versioned) under /boot
	install -d $(CURDIR)/debian/linux-image-pine64/boot
	install -m 0644 arch/arm64/boot/Image.gz \
	  $(CURDIR)/debian/linux-image-pine64/boot/Image-$(KREL).gz
	
	# Also ship config and System.map versioned
	[ -f .config ] && install -m 0644 .config \
	  $(CURDIR)/debian/linux-image-pine64/boot/config-$(KREL) || true
	[ -f System.map ] && install -m 0644 System.map \
	  $(CURDIR)/debian/linux-image-pine64/boot/System.map-$(KREL) || true
	
	# 4) DTBs staged under /usr/lib/linux-image-pine64/allwinner
	install -d $(CURDIR)/debian/linux-image-pine64/usr/lib/linux-image-pine64/allwinner
	for d in $(DTB); do \
	  install -m 0644 arch/arm64/boot/dts/$$d \
	    $(CURDIR)/debian/linux-image-pine64/usr/lib/linux-image-pine64/allwinner/; \
	done
	
	# 5) Store kernel release for postinst to use
	echo "$(KREL)" > $(CURDIR)/debian/linux-image-pine64/usr/lib/linux-image-pine64/kernel-release

override_dh_strip:
	dh_strip -Nlinux-headers-pine64 --no-automatic-dbgsym

override_dh_shlibdeps:
	true

override_dh_builddeb:
	dh_builddeb -- -Zxz

clean:
	dh_clean
	$(MAKE) clean
