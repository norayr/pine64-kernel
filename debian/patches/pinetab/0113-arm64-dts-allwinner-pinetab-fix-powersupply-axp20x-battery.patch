From: Julian <juliannfairfax@protonmail.com>
Date: Tue, 3 Dec 2024 18:34:25 +0000
Subject: arm64: dts: allwinner: pinetab: fix power_supply axp20x-battery

Signed-off-by: Frank S. (alias: gischpelino) <gischpelino@alpenjodel.de>
Signed-off-by: Julian <juliannfairfax@protonmail.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts b/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts
index f9f43ab..c5e7801 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts
@@ -2,6 +2,8 @@
 /*
  * Copyright (C) 2019 Icenowy Zheng <icenowy@aosc.xyz>
  *
+ * 2023: changes by Frank S. (alias: gischpelino) to fix
+ *	   power_supply axp20x-battery: driver failed to report `energy_full_design' property: -22
  */
 
 /dts-v1/;
@@ -18,6 +20,17 @@ / {
 	compatible = "pine64,pinetab", "allwinner,sun50i-a64";
 	chassis-type = "tablet";
 
+		bat: battery {
+				compatible = "simple-battery";
+				voltage-min-design-microvolt = <3000000>;
+				voltage-max-design-microvolt = <4200000>;
+				energy-full-design-microwatt-hours = <25000000>;
+				energy-empty-design-microwatt-hours = <19000000>;
+				charge-full-design-microamp-hours = <5950000>;
+				constant-charge-current-max-microamp = <1200000>;
+				constant-charge-voltage-max-microvolt = <4200000>;
+		};
+
 	aliases {
 		serial0 = &uart0;
 		ethernet0 = &rtl8723cs;
@@ -303,6 +316,7 @@ &ac_power_supply {
 
 &battery_power_supply {
 	status = "okay";
+	monitored-battery = <&bat>;
 };
 
 &reg_aldo1 {
