From: Julian <juliannfairfax@protonmail.com>
Date: Sat, 4 Jan 2025 21:24:20 +0000
Subject: arm64: dts: sun50i-a64-pinetab: Use newer jack detection
 implementaion

Signed-off-by: Ondrej Jirman <megi@xff.cz>
Signed-off-by: Julian <juliannfairfax@protonmail.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts b/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts
index b6c1b96..6f70ff8 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a64-pinetab.dts
@@ -93,6 +93,7 @@ wifi_pwrseq: pwrseq {
 };
 
 &codec {
+	jack-type = "headset";
 	status = "okay";
 };
 
@@ -510,7 +511,7 @@ hdmi_out_con: endpoint {
 &sound {
 	status = "okay";
 	simple-audio-card,name = "PineTab";
-	simple-audio-card,aux-devs = <&codec_analog>, <&speaker_amp>;
+	simple-audio-card,aux-devs = <&codec_analog>, <&codec>, <&speaker_amp>;
 	simple-audio-card,widgets = "Microphone", "Internal Microphone Left",
 				    "Microphone", "Internal Microphone Right",
 				    "Headphone", "Headphone Jack",
