#!/bin/sh
set -e
export INITRD=No

case "$1" in
  configure)
    # newest modules dir = version we just installed
    version="$(ls -1 /lib/modules | sort -V | tail -n1)"

    mkdir -p /boot /boot/allwinner

    if [ -f "/boot/Image-${version}.gz" ]; then
      ln -sf "Image-${version}.gz" /boot/Image.gz
    elif [ -f /boot/Image-.gz ]; then # our previous bug handling
      ln -sf Image-.gz /boot/Image.gz
    fi

    if [ -d /usr/lib/linux-image-pine64/allwinner ]; then
      cp -f /usr/lib/linux-image-pine64/allwinner/*.dtb /boot/allwinner/ 2>/dev/null || true
    fi

    depmod "$version" || true
    ;;
esac

#DEBHELPER#
exit 0

